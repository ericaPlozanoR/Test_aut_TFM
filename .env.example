# ============================================================
# CONFIGURACIÓN DEL FRAMEWORK DE PRUEBAS — Huellas del Catatumbo
# ============================================================
# Copia este archivo como .env y completa los valores reales.
# Los valores con caracteres especiales (# ! @) deben ir entre comillas.
#
#   cp .env.example .env
# ============================================================

# URL base de la plataforma
BASE_URL=https://huellasdelcatatumbo.com

# ── Credenciales por rol ──────────────────────────────────────
# Panel de administración → /login/admin
ADMIN_USER=super_admin
ADMIN_PASS="tu_contraseña_admin"

DIRECTOR_USER=director_fundorex
DIRECTOR_PASS="tu_contraseña_director"

COORDINADOR_USER=coordinador_ocana
COORDINADOR_PASS="tu_contraseña_coordinador"

VOLUNTARIO_USER=voluntario_catatumbo
VOLUNTARIO_PASS="tu_contraseña_voluntario"

# Portal de usuario donante → /login
USUARIO_USER=antuan23
USUARIO_PASS="tu_contraseña_usuario"

# ── Configuración del navegador ───────────────────────────────
# Navegador: chromium | firefox | webkit
BROWSER=chromium

# true = sin ventana (modo CI/CD) | false = con ventana visible
HEADLESS=false

# Milisegundos de espera entre acciones (0 = velocidad máxima, 500 = debug)
SLOWMO=0

# Timeout global por paso en milisegundos
TIMEOUT=30000
